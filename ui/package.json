{
  "name": "conxugal-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interface web de busca e análise de contratos públicos da Xunta de Galicia.",
  "scripts": {
    "dev": "vite",
    "build": "npm run tsc7 -- -b && vite build",
    "tsc7": "node ./node_modules/typescript7/bin/tsc",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:acceptance": "npm run api:up && npm run build && playwright test",
    "test:acceptance:ui": "npm run api:up && npm run build && playwright test --ui",
    "api:up": "docker compose up -d --wait",
    "api:down": "docker compose down"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@mantine/charts": "^9.5.1",
    "@mantine/core": "^9.5.0",
    "@mantine/hooks": "^9.4.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.101.4",
    "es-toolkit": "^1.50.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-router": "^8.3.0",
    "recharts": "^3.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/eslint-plugin": "^1.6.26",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "nock": "^14.0.17",
    "postcss": "^8.5.25",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "volta": {
    "node": "24.18.0"
  }
}
