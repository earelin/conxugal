<?xml version="1.0" encoding="UTF-8"?>

<FindBugsFilter>
  <Match>
    <Annotation name="io.micronaut.core.annotation.Generated"/>
  </Match>
  <Match>
    <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
  </Match>
  <!-- False positive: SpotBugs' MutableClasses heuristic conservatively treats OrganoReconciler
       (and previously OrganoRepository, before it was extracted out of this class) as mutable
       purely for lacking an immutability marker — it is a stateless, constructor-stored
       collaborator like any other, not a leaked mutable data holder. -->
  <Match>
    <Class name="gal.conxugal.domain.organo.ImportOrganos"/>
    <Field name="organoReconciler"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- The same false positive for the taxonomía, classification, import-mark and catalogue-read
       use cases: the heuristic reads TermoRepository and OrganoRepository as mutable purely
       because they declare insert/deleteById, so every constructor-injected port trips it. They
       are stateless collaborators, not leaked data. Named field by field so a genuinely leaked
       mutable stored in one of these classes still reports. -->
  <Match>
    <Class name="~gal\.conxugal\.domain\.organo\.taxonomia\.((Create|Rename|Move|Delete)Termo|ListTermos)"/>
    <Field name="termoRepository"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="~gal\.conxugal\.domain\.organo\.(AssignOrganoToTermo|ClearOrganoTermo|ListOrganos|ListVisibleOrganos|MarkOrganoForImport|UnmarkOrganoForImport|ViewOrgano)"/>
    <Field name="~(organo|termo)Repository"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- And once more for the contratos menores walk: ContratosMenoresImportStateRepository declares
       insert, which is all the heuristic needs to read the injected port as mutable. -->
  <Match>
    <Class name="gal.conxugal.domain.contrato.ImportOrganoContratosMenores"/>
    <Field name="importStates"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- And for the claim, the run that follows it and the per-Órgano step beneath that:
       OrganoRepository declares insert, same as above, and the heuristic reads a constructor-stored
       use case as mutable for the same want of an immutability marker. -->
  <Match>
    <Class name="~gal\.conxugal\.domain\.contrato\.(Claim|Execute)ContratosMenoresImport|gal\.conxugal\.domain\.contrato\.ImportCoveredOrgano"/>
    <Field name="~(organos|coveredOrgano)"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- And once more for the trigger above them, which stores both use cases. -->
  <Match>
    <Class name="gal.conxugal.application.contrato.StartContratosMenoresImport"/>
    <Field name="~(claim|execute)"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- And for the read beside them, which stores the port the claim also writes through. -->
  <Match>
    <Class name="gal.conxugal.domain.importrun.ReadImportRun"/>
    <Field name="importRuns"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- And for the two browse reads, each of which stores the catalogue port — one to derive its
       flags from, the other to refuse an Órgano that does not exist. Only that field: the browse
       port beside it declares reads alone, so the heuristic does not read it as mutable and a
       genuine leak of it would still report. -->
  <Match>
    <Class name="~gal\.conxugal\.domain\.contrato\.(DescribeContratosMenoresSection|ListContratosMenores)"/>
    <Field name="organos"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- And for the endpoints that ask for an import or report one: the same want of an
       immutability marker on a constructor-stored use case. -->
  <Match>
    <Class name="~gal\.conxugal\.application\.rest\.admin\.(contratosmenores\.ContratosMenoresImportController|organos\.OrganoImportMarkController|importruns\.ImportRunController)"/>
    <Field name="~(startImport|readImportRun)"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- And for the batch the walk stores through: OperadorRepository declares insert, same as
       above. -->
  <Match>
    <Class name="gal.conxugal.domain.contrato.StoreContratosMenoresBatch"/>
    <Field name="operadores"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <!-- Micronaut Serde's generated (de)serializers. The @Generated match above cannot reach them:
       they carry javax.annotation.processing.Generated, which is SOURCE-retention and so absent
       from the bytecode SpotBugs reads, unlike Micronaut's own CLASS-retention annotation. -->
  <Match>
    <Class name="~gal\.conxugal\..*\.Serde[A-Z].*(Deserializer|Serializer)(\$.*)?"/>
  </Match>

  <!-- fb-contrib detectors we do not adopt, project-wide. -->

  <!-- Reports the mutual reference between a value object and its converter — the value names its
       converter in @TypeDef, the converter constructs the value — which is inherent to that
       pairing. Either side can be the reported class depending on which the analysis reaches
       first, so both are named rather than only the converter. Scoped to the domain's converted
       value types so a genuine class-level tangle elsewhere still reports — :architecture's
       ArchUnit rules only police the direction between modules, not within one. -->
  <Match>
    <Bug pattern="FCCD_FIND_CLASS_CIRCULAR_DEPENDENCY"/>
    <Or>
      <Class name="~gal\.conxugal\.domain\..*Converter"/>
      <Class name="~gal\.conxugal\.domain\..*Id"/>
      <Class name="gal.conxugal.domain.money.Money"/>
      <Class name="gal.conxugal.domain.operador.FiscalIdentifier"/>
    </Or>
  </Match>

  <!-- Wants checked exceptions propagated rather than wrapped. Adapters deliberately soften them:
       domain ports declare no checked exceptions, so an adapter translating one is the design, and
       test helpers driving those adapters wrap the same way. -->
  <Match>
    <Bug pattern="EXS_EXCEPTION_SOFTENING_NO_CONSTRAINTS"/>
  </Match>

  <!-- Wants parameters widened to the most abstract collection type that compiles. We take the
       type a caller actually passes and widen it when a second caller needs it, not before. -->
  <Match>
    <Bug pattern="OCP_OVERLY_CONCRETE_COLLECTION_PARAMETER"/>
  </Match>

  <!-- Wants every collection allocated at its final size. Sizing a collection is an optimisation
       we make when a measurement asks for it, not by default. -->
  <Match>
    <Bug pattern="PSC_PRESIZE_COLLECTIONS"/>
  </Match>

  <!-- Test-only: each of these fires on a standard JUnit/AssertJ/Mockito idiom rather than on a
       defect — constructing a value inside assertThatThrownBy, stubbing thenReturn(true), and
       calling the method under test twice to compare the two results. -->
  <Match>
    <Class name="~.*Test(\$.*)?"/>
    <Bug pattern="SEC_SIDE_EFFECT_CONSTRUCTOR,NAB_NEEDLESS_BOOLEAN_CONSTANT_CONVERSION,PRMC_POSSIBLY_REDUNDANT_METHOD_CALLS,SEO_SUBOPTIMAL_EXPRESSION_ORDER"/>
  </Match>

  <!-- The plan test builds each statement it EXPLAINs from its own constants, and its four
       orderings are now rendered from SortKey rather than written out — which is the point, since
       that is what keeps them the same four the paged read emits, but it also means the analysis
       can no longer see the statement as a literal. Nothing a caller supplies reaches it: the whole
       class takes no input. Named to this one class so a statement assembled around a value
       elsewhere still reports. -->
  <Match>
    <Class name="gal.conxugal.infrastructure.jdbc.contrato.ContratoMenorVisibleBrowseSchemaIntegrationTest"/>
    <Bug pattern="SQL_INJECTION_JDBC"/>
  </Match>
</FindBugsFilter>
