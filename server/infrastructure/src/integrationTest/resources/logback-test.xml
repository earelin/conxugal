<?xml version="1.0" encoding="UTF-8"?>
<!--
  A binding is on this source set's classpath so that one test can read the SQL Micronaut Data
  emits, which it logs at DEBUG. Without a configuration Logback would default the root to DEBUG
  and every other integration test would drown; that test raises its one logger itself.
-->
<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="warn">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>
